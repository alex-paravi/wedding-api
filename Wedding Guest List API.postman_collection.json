        {
          "name": "Authorization",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// 1. Парсим ответ от сервера",
                  "var jsonData = pm.response.json();",
                  "",
                  "// 2. Достаем токен (проверь, как именно он называется в твоем JSON-ответе: 'token' или 'plainTextToken')",
                  "var token = jsonData.token; ",
                  "",
                  "// 3. Записываем в текущее окружение",
                  "pm.environment.set(\"api_token\", token);"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "exec": [
